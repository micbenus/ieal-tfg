@startuml
title Arquitectura real del prototipo Buscador IEAL
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Cliente REST / Swagger UI" as Client
actor "WordPress (integración futura)" as WP

package "api-rest" {
  [SearchController] as SearchController
  [ContentsController] as ContentsController
  [HealthController] as HealthController
  [ApiExceptionHandler] as Errors
  [openapi.yaml] as OpenAPI
}
package "domain" {
  interface ContentUseCase
  interface ContentRepositoryPort
  [ContentItem] as ContentItem
  [TextNormalizer] as Normalizer
  [RelevanceScorer] as Scorer
}
package "application" {
  [ContentService] as Service
}
package "infra-mongo" {
  [MongoContentRepositoryAdapter] as Adapter
  [SpringDataContentRepository] as Repository
  [ContentDocument] as Document
}
package "boot" {
  [SearchApplication] as Boot
  [ApplicationConfig] as Config
  [SeedDataLoader\nperfil dev] as Loader
}
database "MongoDB 7\nieal_search.contents" as Mongo
file "seed-contents.json\n12 documentos demo" as Seed

Client --> SearchController : HTTP
Client --> ContentsController : HTTP
Client --> HealthController : HTTP
WP ..> SearchController : posible consumo futuro
OpenAPI --> SearchController : contrato generado
OpenAPI --> ContentsController : contrato generado
SearchController --> ContentUseCase
ContentsController --> ContentUseCase
ContentUseCase <|.. Service
Service --> ContentItem
Service --> Normalizer
Service --> Scorer
Service --> ContentRepositoryPort
ContentRepositoryPort <|.. Adapter
Adapter --> Repository
Adapter --> Document
Repository --> Mongo
Boot --> Config
Config --> Service
Loader --> Seed
Loader --> ContentUseCase
Errors ..> SearchController
Errors ..> ContentsController

note bottom of WP
No existe integración real con WordPress.
end note
@enduml
